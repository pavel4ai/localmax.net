{
  "name": "@localmax/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev -c dist/server/wrangler.json",
    "check": "astro check",
    "deploy": "astro build && wrangler deploy -c dist/server/wrangler.json",
    "deploy:staging": "astro build && wrangler deploy -c dist/server/wrangler.json --env staging"
  },
  "dependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "^14.1.7",
    "@cloudflare/workers-types": "^5.20260730.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.118.0"
  }
}
