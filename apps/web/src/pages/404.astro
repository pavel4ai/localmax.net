---
import Layout from "../components/Layout.astro";
---

<Layout title="Not found" noindex>
  <section class="wrap notfound">
    <div class="eyebrow">404</div>
    <h1>Nothing measured here</h1>
    <p class="lede">
      That page does not exist. A result may also have been removed at its contributor's
      request, or withdrawn during review.
    </p>
    <div class="actions">
      <a href="/benchmarks" class="btn btn-primary">Browse benchmarks</a>
      <a href="/results" class="btn">All results</a>
    </div>
  </section>
</Layout>

<style>
  .notfound { max-width: 560px; padding: 120px 24px 160px; }
  .notfound h1 { font-size: 2.2rem; margin: 12px 0 16px; }
  .actions { display: flex; gap: 12px; margin-top: 28px; flex-wrap: wrap; }
</style>
