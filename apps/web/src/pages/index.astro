---
import Layout from "../components/Layout.astro";
import ResultTable from "../components/ResultTable.astro";
import StatTile from "../components/StatTile.astro";
import TrustNotice from "../components/TrustNotice.astro";
import { api, type ProfileSummary, type ResultRow } from "../lib/api";
import { CATEGORY_LABEL, LANE_LABEL, TIER_LABEL, TIER_VRAM, compact, num } from "../lib/format";

const [stats, profileData] = await Promise.all([
  api<{
    totals: { results: number; ranked: number; gpus: number; systems: number; profiles: number } | null;
    recent: ResultRow[];
  }>("/v1/stats"),
  api<{ profiles: ProfileSummary[] }>("/v1/profiles"),
]);

const totals = stats?.totals ?? { results: 0, ranked: 0, gpus: 0, systems: 0, profiles: 0 };
const recent = stats?.recent ?? [];
const profiles = profileData?.profiles ?? [];

const tiers = ["entry", "enthusiast", "frontier"] as const;
const ORDER = ["llm", "vision", "diffusion"];
const byTier = (t: string) =>
  profiles
    .filter((p) => p.tier === t && p.lane === "fp8")
    .sort((a, b) => ORDER.indexOf(a.category) - ORDER.indexOf(b.category));

const TIER_NOTE: Record<string, string> = {
  entry: "The smallest supported card runs this.",
  enthusiast: "Sized to fill 24 GB.",
  frontier: "Sized to fill 64 GB and more.",
};
---

<Layout title="LocalMax">
  <section class="hero">
    <div class="wrap">
      <div class="eyebrow">Open benchmarks for local AI</div>
      <h1>What can your hardware do?</h1>
      <p class="lede">
        The model, the precision, the workload and the container are fixed. Only your
        hardware changes. The numbers compare.
      </p>

      <div class="hero-actions">
        <a href="/run" class="btn btn-primary">Run a benchmark</a>
        <a href="/benchmarks" class="btn">Leaderboards</a>
      </div>
    </div>
  </section>

  <section class="wrap">
    <TrustNotice />
  </section>

  <section class="wrap" style="padding-top:32px">
    <div class="grid grid-4">
      <StatTile label="Results" value={compact(totals.results)} note={`${compact(totals.ranked)} ranked`} />
      <StatTile label="Systems" value={compact(totals.systems)} />
      <StatTile label="GPU models" value={compact(totals.gpus)} />
      <StatTile label="Profiles" value={String(profiles.length)} note="3 categories, 3 tiers, 3 lanes" />
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <div>
        <h2>Three tiers</h2>
        <p class="lede" style="margin-top:8px">
          One model cannot span 12 GB to 192 GB. A tier is the VRAM its run must fill.
          Each tier has its own model.
        </p>
      </div>
    </div>

    <div class="grid grid-3">
      {tiers.map((tier) => {
        const list = byTier(tier);
        const results = list.reduce((sum, p) => sum + p.result_count, 0);
        return (
          <div class="tile tier-card">
            <div class="tile-label">{TIER_LABEL[tier]} · {TIER_VRAM[tier]}</div>
            <div class="tier-note">{TIER_NOTE[tier]}</div>
            <ul class="tier-list">
              {list.map((p) => (
                <li>
                  <a href={`/benchmarks/${p.id}`}>{CATEGORY_LABEL[p.category]}</a>
                  <span class="muted tnum">{num(p.model.parameters_b, 0)}B · {LANE_LABEL[p.lane]}</span>
                </li>
              ))}
              {list.length === 0 && <li class="muted">No profile yet</li>}
            </ul>
            <div class="tile-note">{compact(results)} result{results === 1 ? "" : "s"}</div>
          </div>
        );
      })}
    </div>

    <p class="muted" style="margin-top:18px;font-size:13px">
      Each tier also has an INT4 lane and an NVFP4 lane. LocalMax ranks each lane on its own.
      Different precisions are different work. <a href="/methodology" class="secondary">Methodology →</a>
    </p>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2>Latest results</h2>
      <a href="/results" class="secondary">All results →</a>
    </div>
    <ResultTable
      results={recent}
      emptyMessage="No results yet. The Entry profile runs on a 12 GB card in about 14 minutes."
    />
  </section>

  <section class="section wrap">
    <div class="grid grid-3">
      <div class="tile">
        <div class="tile-label">Fixed</div>
        <div class="tier-note">
          Model, revision, precision, runtime, flags, prompts, token counts, images, steps
          and seeds. The profile holds all of them. LocalMax checks them at submission.
        </div>
      </div>
      <div class="tile">
        <div class="tile-label">Measured</div>
        <div class="tier-note">
          Decode and prefill throughput, time to first token, inter-token latency, seconds
          per step, images per minute, peak VRAM, power, energy and throttle events.
        </div>
      </div>
      <div class="tile">
        <div class="tile-label">Published</div>
        <div class="tier-note">
          The manifest, the raw records, the telemetry and the system report. LocalMax
          computes each ranked number again from the raw data before it accepts a result.
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero { padding: 88px 0 40px; }
  .hero h1 { margin: 14px 0 18px; }
  .hero .lede { font-size: 1.1rem; }
  .hero-actions { display: flex; gap: 12px; margin-top: 26px; flex-wrap: wrap; }

  .tier-card { gap: 10px; padding: 22px; }
  .tier-note { font-size: 13px; color: var(--text-secondary); line-height: 1.5; }
  .tier-list { list-style: none; margin: 4px 0 0; padding: 0; display: grid; gap: 6px; }
  .tier-list li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 13px;
    padding: 5px 0;
    border-top: 1px solid var(--grid);
  }
  @media (max-width: 640px) {
    .hero { padding: 52px 0 32px; }
  }
</style>
