---
import Layout from "../components/Layout.astro";
import { api } from "../lib/api";

const challengeId = Astro.url.searchParams.get("c") ?? "";
const valid = /^[0-9a-f]{32}$/.test(challengeId);

const config = await api<{ turnstile_site_key: string }>("/v1/config");
const siteKey = config?.turnstile_site_key ?? "";
---

<Layout title="Verify submission" noindex>
  <section class="wrap verify">
    <div class="eyebrow">Submission</div>
    <h1>One quick check</h1>

    {!valid ? (
      <p class="lede">
        This link is missing its challenge code. Run <code>localmax submit</code> again to get
        a fresh one.
      </p>
    ) : (
      <>
        <p class="lede">
          LocalMax accepts results anonymously — no account, no email, no GitHub token. This
          one browser check is what keeps bulk fabrication expensive. It does not identify you
          and nothing about you is stored.
        </p>

        <div class="widget">
          {/* The challenge id rides on a data attribute rather than an injected variable, so
              the script below is a plain static asset with nothing templated into it. */}
          <div
            id="turnstile"
            class="cf-turnstile"
            data-sitekey={siteKey}
            data-challenge={challengeId}
            data-callback="lmVerify"
            data-error-callback="lmVerifyError"
            data-theme="dark"
          ></div>
          <p id="status" class="status">Loading the check…</p>
          <noscript>
            <p class="status err">
              This step needs JavaScript. It is the only page on the site that does.
            </p>
          </noscript>
        </div>

        <p class="muted small">
          Your terminal is polling for this. Once it turns green you can close this tab and
          watch the upload finish there.
        </p>
      </>
    )}
  </section>

  {valid && (
    <>
      {/*
        Two independent paths to a rendered widget, because each alone has failed here:

        - Implicit rendering scans the DOM for `.cf-turnstile` when the script loads. The
          markup provides everything it needs, but with `async defer` and a redirect in
          front of the script that scan does not always happen.
        - `?onload=` does not survive at all: api.js answers 302 to
          /turnstile/v0/g/<hash>/api.js and the redirect drops the query string, so the
          callback is never invoked.

        So the script below also polls for the API to become usable and renders by hand if
        the implicit pass did not, guarding on child nodes so the two can never both draw.
        Note that `window.turnstile` is installed as an empty stub immediately and filled
        in later, so the guard has to test for `render` rather than for the object.
      */}
      <script is:inline>
        (function () {
          const el = document.getElementById("turnstile");
          const status = document.getElementById("status");
          const challengeId = el.dataset.challenge;

          function say(text, kind) {
            status.textContent = text;
            status.className = "status" + (kind ? " " + kind : "");
          }

          // Named globals so implicit rendering can reach the same handlers.
          window.lmVerify = submitToken;
          window.lmVerifyError = function (code) {
            say("Verification error " + (code || "unknown") + ". Reload to try again.", "err");
          };

          async function submitToken(token) {
            say("Verifying…");
            try {
              const res = await fetch("/api/challenge/" + challengeId + "/solve", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ turnstile_token: token }),
              });
              if (res.ok) {
                say("Verified. You can close this tab — your terminal is continuing.", "ok");
              } else {
                const body = await res.json().catch(() => ({}));
                say(body.message || "Verification failed. Run `localmax submit` again.", "err");
              }
            } catch (_) {
              say("Could not reach the verification service. Check your connection and retry.", "err");
            }
          }

          function render() {
            if (el.hasChildNodes()) return; // implicit rendering already drew it
            say("Complete the check below.");
            try {
              window.turnstile.render(el, {
                sitekey: el.dataset.sitekey,
                theme: "dark",
                callback: submitToken,
                "error-callback": function (code) {
                  say("Verification error " + (code || "unknown") + ". Reload to try again.", "err");
                },
                "expired-callback": function () {
                  say("The check expired. Reload the page to try again.", "err");
                },
                "timeout-callback": function () {
                  say("The check timed out. Reload the page to try again.", "err");
                },
              });
            } catch (e) {
              say("Could not start the check: " + (e && e.message ? e.message : e), "err");
            }
          }

          // Distinguishes "the script never arrived" from "it arrived and drew nothing",
          // because those need different fixes and a single generic message hides which.
          var waited = 0;
          var timer = setInterval(function () {
            if (el.hasChildNodes()) { clearInterval(timer); say("Complete the check below."); return; }
            if (window.turnstile && typeof window.turnstile.render === "function") {
              clearInterval(timer);
              render();
              setTimeout(function () {
                if (!el.hasChildNodes()) {
                  say("The check loaded but drew nothing. This is a bug — please report it.", "err");
                }
              }, 5000);
              return;
            }
            waited += 100;
            if (waited >= 15000) {
              clearInterval(timer);
              say("The verification script did not load. Disable any script blocker and reload.", "err");
            }
          }, 100);
        })();
      </script>
      <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    </>
  )}
</Layout>

<style>
  .verify { max-width: 620px; padding: 88px 24px 120px; }
  .verify h1 { font-size: 2rem; margin: 12px 0 16px; }
  .widget { margin: 32px 0 20px; min-height: 90px; }
  .status { font-size: 13.5px; color: var(--text-muted); margin-top: 16px; }
  .status.ok { color: var(--good); }
  .status.err { color: var(--critical); }
  .small { font-size: 12.5px; }
</style>
