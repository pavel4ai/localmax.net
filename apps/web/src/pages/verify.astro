---
import Layout from "../components/Layout.astro";
import { api } from "../lib/api";

const challengeId = Astro.url.searchParams.get("c") ?? "";
const valid = /^[0-9a-f]{32}$/.test(challengeId);

const config = await api<{ turnstile_site_key: string }>("/v1/config");
const siteKey = config?.turnstile_site_key ?? "";
---

<Layout title="Verify submission" noindex>
  <section class="wrap verify">
    <div class="eyebrow">Submission</div>
    <h1>One quick check</h1>

    {!valid ? (
      <p class="lede">
        This link is missing its challenge code. Run <code>localmax submit</code> again to get
        a fresh one.
      </p>
    ) : (
      <>
        <p class="lede">
          LocalMax accepts results anonymously — no account, no email, no GitHub token. This
          one browser check is what keeps bulk fabrication expensive. It does not identify you
          and nothing about you is stored.
        </p>

        <div class="widget">
          {/*
            Canonical implicit-render markup. The challenge id rides on a data attribute so
            the script stays static with nothing templated into it.

            Every id here is namespaced, and that is load-bearing rather than tidiness.
            Browsers expose each element id as a global, so `id="turnstile"` made
            `window.turnstile` the div itself. The loader's guard is `"turnstile" in window`,
            so it concluded the API was already present, logged "Turnstile already has been
            loaded" and returned without installing it — leaving an object with no render
            method and a widget that never appeared, on any browser, deterministically.
          */}
          <div
            id="lm-turnstile"
            class="cf-turnstile"
            data-sitekey={siteKey}
            data-challenge={challengeId}
            data-action="submit"
            data-callback="lmVerify"
            data-error-callback="lmVerifyError"
            data-theme="dark"
          ></div>
          <p id="lm-status" class="status">Loading the check…</p>
          <p id="lm-diag" class="diag"></p>
          <noscript>
            <p class="status err">
              This step needs JavaScript. It is the only page on the site that does.
            </p>
          </noscript>
        </div>

        <p class="muted small">
          Your terminal is polling for this. Once it turns green you can close this tab and
          watch the upload finish there.
        </p>
      </>
    )}
  </section>

  {valid && (
    <script is:inline>
      (function () {
        var el = document.getElementById("lm-turnstile");
        var statusEl = document.getElementById("lm-status");
        var diagEl = document.getElementById("lm-diag");
        var challengeId = el.dataset.challenge;
        var t0 = Date.now();
        var scriptLoaded = null; // null = pending, true = onload, false = onerror

        function say(text, kind) {
          statusEl.textContent = text;
          statusEl.className = "status" + (kind ? " " + kind : "");
        }

        // Shown only on failure. Turnstile's own failure mode is an empty box and silence,
        // which is unactionable for whoever hits it; this states which step broke, so a bug
        // report carries the one fact that separates the possible causes.
        function diagnose() {
          var ts = typeof window.turnstile;
          diagEl.textContent =
            "diagnostic: script=" +
            (scriptLoaded === null ? "pending" : scriptLoaded ? "loaded" : "blocked") +
            " · api=" + ts +
            (ts === "object" && window.turnstile ? "/render=" + typeof window.turnstile.render : "") +
            " · widget=" + (el.hasChildNodes() ? "drawn" : "empty") +
            " · " + Math.round((Date.now() - t0) / 1000) + "s";
        }

        window.lmVerify = async function (token) {
          say("Verifying…");
          try {
            var res = await fetch("/api/challenge/" + challengeId + "/solve", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ turnstile_token: token }),
            });
            if (res.ok) {
              say("Verified. You can close this tab — your terminal is continuing.", "ok");
              diagEl.textContent = "";
            } else {
              var body = await res.json().catch(function () { return {}; });
              say(body.message || "Verification failed. Run `localmax submit` again.", "err");
            }
          } catch (_) {
            say("Could not reach the verification service. Check your connection and retry.", "err");
          }
        };

        window.lmVerifyError = function (code) {
          say("Verification error " + (code || "unknown") + ". Reload to try again.", "err");
          diagnose();
        };

        function renderIfNeeded() {
          if (el.hasChildNodes()) return true;
          if (!window.turnstile || typeof window.turnstile.render !== "function") return false;
          try {
            window.turnstile.render(el, {
              sitekey: el.dataset.sitekey,
              action: "submit",
              theme: "dark",
              callback: window.lmVerify,
              "error-callback": window.lmVerifyError,
              "expired-callback": function () {
                say("The check expired. Reload the page to try again.", "err");
              },
            });
          } catch (e) {
            say("Could not start the check: " + (e && e.message ? e.message : e), "err");
            diagnose();
          }
          return true;
        }

        // The API is loaded by hand so onload and onerror can be observed. From a plain
        // <script> tag in markup there is no way to tell "blocked by an extension or the
        // network" apart from "loaded but never initialised", and those need opposite fixes.
        var s = document.createElement("script");
        s.src = "https://challenges.cloudflare.com/turnstile/v0/api.js";
        s.async = true;
        s.defer = true;
        s.onload = function () { scriptLoaded = true; };
        s.onerror = function () {
          scriptLoaded = false;
          say("The verification script was blocked before it loaded. A browser extension, a corporate proxy or a DNS filter is stopping challenges.cloudflare.com.", "err");
          diagnose();
        };
        document.head.appendChild(s);

        var waited = 0;
        var timer = setInterval(function () {
          if (renderIfNeeded()) {
            clearInterval(timer);
            say("Complete the check below.");
            return;
          }
          waited += 100;
          if (waited >= 20000) {
            clearInterval(timer);
            if (scriptLoaded === false) return; // onerror already reported it
            say(
              scriptLoaded
                ? "The check loaded but never started. This is usually an extension interfering with challenges.cloudflare.com."
                : "The check did not load in 20 seconds. It is most likely blocked by an extension, proxy or DNS filter.",
              "err",
            );
            diagnose();
          }
        }, 100);
      })();
    </script>
  )}
</Layout>

<style>
  .verify { max-width: 620px; padding: 88px 24px 120px; }
  .verify h1 { font-size: 2rem; margin: 12px 0 16px; }
  .widget { margin: 32px 0 20px; min-height: 90px; }
  .status { font-size: 13.5px; color: var(--text-muted); margin-top: 16px; }
  .status.ok { color: var(--good); }
  .status.err { color: var(--critical); }
  .diag {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--text-muted);
    margin-top: 8px;
    overflow-wrap: anywhere;
  }
  .small { font-size: 12.5px; }
</style>
