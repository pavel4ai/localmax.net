---
import Layout from "../../components/Layout.astro";
import ResultTable from "../../components/ResultTable.astro";
import StatTile from "../../components/StatTile.astro";
import { api, type ResultRow } from "../../lib/api";
import {
  CATEGORY_LABEL, LANE_LABEL, TIER_LABEL, bytes, compact, metricLabel, num, short, watts,
} from "../../lib/format";

const { gpu: gpuKey } = Astro.params;

interface HardwareDetail {
  gpu: Record<string, any>;
  by_profile: Array<{
    profile_id: string; category: string; tier: string; lane: string;
    headline_metric: string; headline_unit: string; headline_direction: string;
    samples: number; ranked: number;
    min_value: number; max_value: number; mean_value: number;
    mean_power: number | null; mean_vram: number | null;
  }>;
  results: ResultRow[];
  eligible_tiers: string[];
}

const detail = await api<HardwareDetail>(`/v1/hardware/${gpuKey}`);
if (!detail) return new Response(null, { status: 404, statusText: "GPU not found" });

const g = detail.gpu;
const rows = detail.by_profile;
const results = detail.results;

// One GPU runs profiles from every category, so these rows measure tokens per second,
// seconds per diffusion step and images per minute. Those cannot share an axis: bar length
// would encode nothing, and a caption disclaiming that is not a fix. It is a table.
const CATEGORY_ORDER = ["llm", "vision", "diffusion"];
const TIER_ORDER = ["entry", "enthusiast", "frontier"];
const byCategory = CATEGORY_ORDER.map((category) => ({
  category,
  rows: rows
    .filter((p) => p.category === category)
    .sort(
      (a, b) =>
        TIER_ORDER.indexOf(a.tier) - TIER_ORDER.indexOf(b.tier) ||
        a.lane.localeCompare(b.lane),
    ),
})).filter((group) => group.rows.length > 0);

const best = (p: { headline_direction: string; max_value: number; min_value: number }) =>
  p.headline_direction === "higher_is_better" ? p.max_value : p.min_value;

const totalResults = rows.reduce((s, p) => s + p.samples, 0);
---

<Layout title={short(g.name ?? gpuKey)} description={`Every LocalMax benchmark result for the ${g.name ?? gpuKey}.`}>
  <section class="wrap" style="padding:48px 0 0">
    <div class="eyebrow"><a href="/hardware">Hardware</a></div>
    <h1 style="margin:12px 0 14px;font-size:2.1rem">{short(g.name ?? gpuKey)}</h1>
    {g.architecture && (
      <p class="lede">
        {g.architecture} · {bytes(g.vram_bytes)} {g.memory_type === "unified" ? "unified memory" : "VRAM"}
        {g.memory_bandwidth_gb_s ? ` · ${num(g.memory_bandwidth_gb_s, 0)} GB/s` : ""}
        {g.default_power_limit_w ? ` · ${g.default_power_limit_w} W` : ""}
        {` · lanes: ${[g.supports_fp8 ? "FP8" : null, "INT4", g.supports_nvfp4 ? "NVFP4" : null].filter(Boolean).join(", ")}`}
      </p>
    )}

    <div class="grid grid-4" style="margin-top:26px">
      <StatTile label="Results" value={compact(totalResults)} />
      <StatTile label="Profiles run" value={String(rows.length)} />
      <StatTile
        label="Eligible tiers"
        value={detail.eligible_tiers.length ? detail.eligible_tiers.map((t) => TIER_LABEL[t]).join(", ") : "—"}
      />
      <StatTile
        label="Typical power"
        value={watts(rows.find((p) => p.mean_power)?.mean_power ?? null)}
        note={g.memory_type === "unified" ? "SoC module" : "GPU board"}
      />
    </div>
  </section>

  {g.notes?.length > 0 && (
    <section class="wrap" style="padding-top:26px">
      <div class="panel" style="max-width:var(--measure)">
        <div class="tile-label" style="margin-bottom:10px">About this GPU</div>
        <ul class="notes">{g.notes.map((n: string) => <li>{n}</li>)}</ul>
      </div>
    </section>
  )}

  {byCategory.length > 0 && (
    <section class="section wrap">
      <div class="section-head">
        <h2>Best result per profile</h2>
        <span class="muted" style="font-size:13px">Grouped by category, because the units differ</span>
      </div>

      {byCategory.map((group) => (
        <div class="category-block">
          <h3>{CATEGORY_LABEL[group.category] ?? group.category}</h3>
          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th>Profile</th>
                  <th>Ranked on</th>
                  <th class="num">Best</th>
                  <th class="num">Mean</th>
                  <th class="num">Samples</th>
                  <th class="num">Mean power</th>
                  <th class="num">Mean peak VRAM</th>
                </tr>
              </thead>
              <tbody>
                {group.rows.map((p) => (
                  <tr>
                    <td class="primary">
                      <a href={`/benchmarks/${p.profile_id}`}>
                        {TIER_LABEL[p.tier] ?? p.tier} · {LANE_LABEL[p.lane] ?? p.lane}
                      </a>
                    </td>
                    <td class="dim">{metricLabel(p.headline_metric)}</td>
                    <td class="num primary">
                      {num(best(p))}<span class="muted"> {p.headline_unit}</span>
                    </td>
                    <td class="num dim">{num(p.mean_value)}</td>
                    <td class="num dim">{p.samples}</td>
                    <td class="num dim">
                      {p.mean_power ? watts(p.mean_power) : "—"}
                      {g.memory_type === "unified" && p.mean_power ? <span class="muted"> soc</span> : ""}
                    </td>
                    <td class="num dim">{p.mean_vram ? bytes(p.mean_vram) : "—"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}

      <p class="muted" style="font-size:12.5px;margin-top:16px;max-width:var(--measure)">
        These rows measure different things: tokens for each second, seconds for each step,
        images for each minute. They do not share an axis. Open a profile to see this GPU
        against comparable results.
      </p>
    </section>
  )}

  <section class="section wrap">
    <div class="section-head">
      <h2>All results</h2>
      <a href={`/results?gpu=${gpuKey}`} class="secondary">Filter the full list →</a>
    </div>
    <ResultTable results={results} emptyMessage="No results submitted for this GPU yet." />
  </section>
</Layout>

<style>
  .category-block { margin-bottom: 28px; }
  .category-block h3 {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 10px;
  }
  .notes { margin: 0; padding-left: 18px; display: grid; gap: 9px; font-size: 13px; color: var(--text-secondary); }
</style>
