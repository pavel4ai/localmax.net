---
import Layout from "../../components/Layout.astro";
import { api, type GpuSummary } from "../../lib/api";
import { TIER_LABEL, bytes, compact, num, short } from "../../lib/format";

const data = await api<{
  gpus: GpuSummary[];
  unregistered: Array<{ key: string; name: string; result_count: number }>;
}>("/v1/hardware");

const gpus = data?.gpus ?? [];
const unregistered = data?.unregistered ?? [];

const classes = ["entry", "enthusiast", "prospector"] as const;
const CLASS_NOTE: Record<string, string> = {
  entry: "12 GB to 17 GB. Runs the Entry tier.",
  enthusiast: "24 GB to 48 GB. Runs Entry and Enthusiast.",
  prospector: "64 GB and more, including unified memory. Runs all three tiers.",
};
---

<Layout title="Hardware" description="Every GPU LocalMax recognises, with the benchmark tiers it qualifies for and how many results it has.">
  <section class="wrap" style="padding:48px 0 0">
    <div class="eyebrow">Hardware</div>
    <h1 style="margin:12px 0 14px;font-size:2.1rem">Supported GPUs</h1>
    <p class="lede">
      LocalMax computes the tier from the total VRAM in a system, not from one card. Two
      RTX PRO 6000 cards reach Prospector, and so does a DGX Spark.
    </p>
  </section>

  {classes.map((cls) => {
    const list = gpus.filter((g) => g.class === cls);
    if (list.length === 0) return null;
    return (
      <section class="section wrap">
        <div class="section-head">
          <h2>{TIER_LABEL[cls]} class</h2>
          <span class="muted" style="font-size:13px">{CLASS_NOTE[cls]}</span>
        </div>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>GPU</th>
                <th class="num">VRAM</th>
                <th class="num">Bandwidth</th>
                <th class="num">TDP</th>
                <th>Architecture</th>
                <th>Lanes</th>
                <th>Tiers</th>
                <th class="num">Results</th>
              </tr>
            </thead>
            <tbody>
              {list.map((g) => (
                <tr>
                  <td class="primary"><a href={`/hardware/${g.key}`}>{short(g.name)}</a></td>
                  <td class="num dim">{bytes(g.vram_bytes)}</td>
                  <td class="num dim">{num(g.memory_bandwidth_gb_s, 0)} GB/s</td>
                  <td class="num dim">{g.default_power_limit_w} W</td>
                  <td class="dim">{g.architecture}{g.memory_type === "unified" ? " · unified" : ""}</td>
                  <td class="dim">
                    BF16 · INT4{g.supports_nvfp4 ? " · NVFP4" : ""}
                  </td>
                  <td class="dim">{g.eligible_tiers.map((t) => TIER_LABEL[t]).join(", ")}</td>
                  <td class="num">{g.result_count > 0 ? compact(g.result_count) : <span class="muted">—</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    );
  })}

  {unregistered.length > 0 && (
    <section class="section wrap">
      <div class="section-head">
        <h2>Seen but not yet in the registry</h2>
      </div>
      <p class="lede">
        These GPUs appear in results, but LocalMax has no verified specification for them.
        They stay out of any view that uses bandwidth until someone adds a specification with
        a manufacturer source.
      </p>
      <div class="table-scroll" style="margin-top:16px">
        <table>
          <thead><tr><th>Reported name</th><th class="num">Results</th></tr></thead>
          <tbody>
            {unregistered.map((g) => (
              <tr><td><a href={`/hardware/${g.key}`}>{g.name}</a></td><td class="num dim">{g.result_count}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section class="section wrap">
    <div class="panel" style="max-width:var(--measure)">
      <h3>A note on DGX Spark</h3>
      <p style="margin-top:10px">
        GB10 is an aarch64 system. Its 128 GB of LPDDR5X is shared between the CPU and the
        GPU. It has large capacity and moderate bandwidth. It holds models that no other
        system here can hold. It is slower than a discrete card on decode.
      </p>
      <p style="margin-bottom:0">
        Its power is measured at the SoC module, not at a GPU board. These are different
        quantities. LocalMax shows the wattage with a label, but it does not rank a Spark for
        energy against a discrete card.
      </p>
    </div>
  </section>
</Layout>
