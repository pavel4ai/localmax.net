---
interface Props {
  verification: string;
  ranked?: number | boolean;
  compact?: boolean;
}
const { verification, ranked, compact = false } = Astro.props;

const LABEL: Record<string, string> = {
  verified: "Verified",
  community: "Community",
  flagged: "Flagged",
  rejected: "Rejected",
};

const TITLE: Record<string, string> = {
  verified:
    "Signed image. Profile hash agrees. Evidence complete. LocalMax computed each value again from the raw records.",
  community:
    "Manifest and signature are valid, but the evidence is incomplete or the image is not an official release. Published, not ranked.",
  flagged:
    "A value is outside the expected range for this hardware. Held for review. LocalMax changed nothing.",
  rejected: "Failed a check. Not published.",
};

const isRanked = ranked === 1 || ranked === true;
const showUnranked = !compact && verification !== "rejected" && !isRanked;
---

<span class={`badge badge-${verification}`} title={TITLE[verification]}>
  <span class="dot" aria-hidden="true"></span>{LABEL[verification] ?? verification}
</span>
{showUnranked && (
  <span
    class="badge badge-unranked"
    title="Published with all raw values, but not ranked: a profile gate did not pass."
  >
    <span class="dot" aria-hidden="true"></span>Unranked
  </span>
)}
