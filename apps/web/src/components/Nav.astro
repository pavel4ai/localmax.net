---
const path = Astro.url.pathname;
const links = [
  { href: "/benchmarks", label: "Benchmarks" },
  { href: "/results", label: "Results" },
  { href: "/hardware", label: "Hardware" },
  { href: "/compare", label: "Compare" },
  { href: "/methodology", label: "Methodology" },
];
const active = (href: string) => path === href || path.startsWith(href + "/");
---

<header class="nav">
  <div class="wrap nav-inner">
    <a href="/" class="brand" aria-label="LocalMax home">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <rect x="0" y="11" width="4" height="7" rx="1" fill="currentColor" opacity="0.45"></rect>
        <rect x="7" y="6" width="4" height="12" rx="1" fill="currentColor" opacity="0.75"></rect>
        <rect x="14" y="0" width="4" height="18" rx="1" fill="currentColor"></rect>
      </svg>
      <span>LocalMax</span>
    </a>

    <nav aria-label="Main">
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={active(l.href) ? "page" : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav-actions">
      <button id="theme-toggle" type="button" aria-label="Switch colour theme" title="Switch colour theme">
        <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="8" cy="8" r="3.2"></circle>
          <path d="M8 1v1.6M8 13.4V15M15 8h-1.6M2.6 8H1M12.9 3.1l-1.1 1.1M4.2 11.8l-1.1 1.1M12.9 12.9l-1.1-1.1M4.2 4.2L3.1 3.1"></path>
        </svg>
      </button>
      <a href="/run" class="btn btn-primary nav-cta">Run a benchmark</a>
    </div>
  </div>
</header>

<script is:inline>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem("lm-theme", next); } catch (_) {}
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--page) 88%, transparent);
    backdrop-filter: saturate(150%) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 56px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-size: 15px;
    color: var(--text-primary);
    flex: none;
  }
  .brand:hover { color: var(--text-primary); }
  nav { flex: 1; min-width: 0; overflow-x: auto; scrollbar-width: none; }
  nav::-webkit-scrollbar { display: none; }
  nav ul {
    display: flex;
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    font-size: 13.5px;
    color: var(--text-muted);
    white-space: nowrap;
    padding: 4px 0;
    border-bottom: 1px solid transparent;
  }
  nav a:hover { color: var(--text-primary); }
  nav a[aria-current="page"] {
    color: var(--text-primary);
    border-bottom-color: var(--accent);
  }
  .nav-actions { display: flex; align-items: center; gap: 10px; flex: none; }
  #theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    color: var(--text-muted);
    background: transparent;
  }
  #theme-toggle:hover { color: var(--text-primary); }
  .nav-cta { padding: 7px 13px; font-size: 13px; }
  @media (max-width: 720px) {
    .nav-cta { display: none; }
    .nav-inner { gap: 16px; }
  }
</style>
