# Copy to `.env` (gitignored) for local development.
# Cloudflare credentials belong in `.cloudflare`, which is also gitignored.

# --- Runner ---------------------------------------------------------------
# Where the runner submits results. Override for a local Worker.
LOCALMAX_API_URL=https://api.localmax.net
# Content-addressed model + container cache. Defaults to ~/.localmax
LOCALMAX_HOME=
# Hugging Face token, only needed for gated model repositories.
HF_TOKEN=

# --- API Worker (local dev, put real values in apps/api/.dev.vars) ---------
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
ARCHIVE_TOKEN=
