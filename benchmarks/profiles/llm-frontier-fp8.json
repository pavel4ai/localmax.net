{
  "$schema": "../../schemas/profile.schema.json",
  "schema_version": "1.0.0",
  "id": "llm-frontier-fp8",
  "version": "0.1.0",
  "frozen": false,
  "published": false,
  "display_name": "LLM \u00b7 Frontier \u00b7 FP8",
  "summary": "A 32B model at FP8, sized to fill 64 GB. It fits a DGX Spark and a dual RTX PRO 6000 workstation. It accepts 1 or 2 GPUs, ranked separately.",
  "category": "llm",
  "tier": "frontier",
  "lane": "fp8",
  "requirements": {
    "min_vram_bytes": 68719476736,
    "min_system_ram_bytes": 68719476736,
    "min_disk_bytes": 206158430208,
    "min_driver": "550.54",
    "min_compute_capability": "8.9",
    "architectures": [
      "blackwell",
      "blackwell-gb10",
      "hopper"
    ],
    "platforms": [
      "linux/amd64",
      "linux/arm64"
    ],
    "gpu_count": [
      1,
      2
    ],
    "expected_runtime_minutes": 14,
    "expected_download_bytes": 37795712204
  },
  "model": {
    "repository": "Qwen/Qwen3-32B",
    "revision": "PENDING",
    "precision": "fp8_e4m3",
    "parameters_b": 32.0,
    "weights_bytes": 37795712204,
    "license": "Apache-2.0",
    "files": []
  },
  "runtime": {
    "name": "vllm",
    "version": "0.26.0",
    "harness": "aiperf",
    "harness_version": "0.7.0",
    "server_ready_timeout_s": 900,
    "flags": {
      "dtype": "auto",
      "max-model-len": 32768,
      "gpu-memory-utilization": 0.9,
      "max-num-seqs": 16,
      "enforce-eager": false,
      "disable-log-requests": true,
      "tensor-parallel-size": 1,
      "swap-space": 0,
      "quantization": "fp8"
    },
    "flag_overrides_allowed": []
  },
  "workloads": [
    {
      "id": "interactive",
      "kind": "llm_interactive",
      "required_for_rank": true,
      "warmup_requests": 8,
      "measured_requests": 64,
      "timeout_s": 900,
      "config": {
        "input_tokens": 1024,
        "output_tokens": 256,
        "concurrency": 1,
        "input_source": "fixed_synthetic",
        "input_seed": 20260801,
        "temperature": 0,
        "ignore_eos": true,
        "streaming": true
      }
    },
    {
      "id": "concurrency",
      "kind": "llm_concurrency",
      "required_for_rank": true,
      "warmup_requests": 8,
      "measured_requests": 128,
      "timeout_s": 1800,
      "config": {
        "input_tokens": 1024,
        "output_tokens": 256,
        "concurrency_sweep": [
          1,
          2,
          4,
          8
        ],
        "input_source": "fixed_synthetic",
        "input_seed": 20260801,
        "temperature": 0,
        "ignore_eos": true,
        "streaming": true
      }
    },
    {
      "id": "longcontext",
      "kind": "llm_longcontext",
      "required_for_rank": false,
      "warmup_requests": 1,
      "measured_requests": 8,
      "timeout_s": 1200,
      "config": {
        "input_tokens": 8192,
        "output_tokens": 1024,
        "concurrency": 1,
        "input_source": "fixed_synthetic",
        "input_seed": 20260801,
        "temperature": 0,
        "ignore_eos": true,
        "streaming": true,
        "reported_as": "pass_fail"
      }
    }
  ],
  "ranking": {
    "metric": "decode_throughput_tok_s",
    "unit": "tok/s",
    "direction": "higher_is_better",
    "source_workload": "interactive",
    "secondary": [
      {
        "metric": "prefill_throughput_tok_s",
        "label": "Prefill",
        "unit": "tok/s",
        "direction": "higher_is_better",
        "source_workload": "interactive"
      },
      {
        "metric": "ttft_p50_ms",
        "label": "TTFT p50",
        "unit": "ms",
        "direction": "lower_is_better",
        "source_workload": "interactive"
      },
      {
        "metric": "ttft_p95_ms",
        "label": "TTFT p95",
        "unit": "ms",
        "direction": "lower_is_better",
        "source_workload": "interactive"
      },
      {
        "metric": "itl_p95_ms",
        "label": "Inter-token p95",
        "unit": "ms",
        "direction": "lower_is_better",
        "source_workload": "interactive"
      },
      {
        "metric": "peak_output_throughput_tok_s",
        "label": "Peak throughput @c8",
        "unit": "tok/s",
        "direction": "higher_is_better",
        "source_workload": "concurrency"
      },
      {
        "metric": "energy_per_output_token_j",
        "label": "Energy / token",
        "unit": "J",
        "direction": "lower_is_better",
        "source_workload": "interactive"
      },
      {
        "metric": "model_load_s",
        "label": "Model load",
        "unit": "s",
        "direction": "lower_is_better",
        "source_workload": "interactive"
      }
    ],
    "gates": [
      {
        "metric": "ttft_p95_ms",
        "comparator": "lte",
        "value": 3000,
        "source_workload": "interactive",
        "reason": "A result that cannot answer within 3 s at concurrency 1 is not an interactive system."
      },
      {
        "metric": "itl_p95_ms",
        "comparator": "lte",
        "value": 200,
        "source_workload": "interactive",
        "reason": "Below roughly 5 tok/s the experience is not usable; such a run is published but not ranked."
      },
      {
        "metric": "error_ratio",
        "comparator": "lte",
        "value": 0.0,
        "source_workload": "interactive",
        "reason": "Any failed request invalidates the measurement."
      }
    ]
  },
  "validation": {
    "required_artifacts": [
      "raw_records",
      "telemetry",
      "system_report",
      "runtime_log"
    ],
    "telemetry_interval_ms": 100,
    "min_telemetry_coverage_pct": 99.0,
    "metric_recompute_tolerance_pct": 0.5,
    "max_repeat_cv_pct": 3.0,
    "plausibility": {
      "decode_throughput_tok_s": {
        "min": 0.5,
        "max": 5000
      },
      "prefill_throughput_tok_s": {
        "min": 1,
        "max": 500000
      },
      "ttft_p50_ms": {
        "min": 1,
        "max": 120000
      },
      "vram_peak_bytes": {
        "min": 1073741824,
        "max": 206158430208
      },
      "power_avg_w": {
        "min": 5,
        "max": 1200
      }
    }
  },
  "notes": [
    "This profile is a release candidate. The runtime is pinned. The model revision is not final. This leaderboard is provisional.",
    "A 32B model at FP8 fits a DGX Spark and a dual RTX PRO 6000 workstation. A 70B model would exclude the Spark from its own tier.",
    "This profile accepts 1 or 2 GPUs. LocalMax ranks each count separately.",
    "The RTX PRO 6000 Blackwell has no NVLink. A 2-GPU result uses PCIe. The result page shows the PCIe generation and width."
  ]
}
